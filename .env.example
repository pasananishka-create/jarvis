# --- AI Backends ---
# At least one backend is required. Primary = OpenAI by default.

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local, offline fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Abilities ---
# Web search (uses DuckDuckGo — no API key needed)
# For Google: set GOOGLE_API_KEY and GOOGLE_CSE_ID
WEB_SEARCH_PROVIDER=duckduckgo

# Voice settings
VOICE_ENABLED=false
WAKE_WORD=jarvis
